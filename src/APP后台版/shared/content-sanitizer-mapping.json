  "usage": {
    "description": "使用说明",
    "functions": {
      "sanitizeText": {
        "description": "对单个文本进行去敏感化处理",
        "params": ["text: string"],
        "returns": "string"
      },
      "sanitizeObject": {
        "description": "对对象进行深度去敏感化处理（支持嵌套路径）",
        "params": ["obj: any", "keys: string[]"],
        "returns": "any"
      },
      "sanitizeExportFileName": {
        "description": "对导出文件名进行去敏感化处理",
        "params": ["originalName: string"],
        "returns": "string"
      },
      "getSanitizedCategory": {
        "description": "获取去敏感化的分类名",
        "params": ["category: string"],
        "returns": "string"
      },
      "getSanitizedFieldLabel": {
        "description": "获取去敏感化的字段标签",
        "params": ["field: string"],
        "returns": "string"
      },
      "getSanitizedUiText": {
        "description": "获取去敏感化的界面文本",
        "params": ["text: string"],
        "returns": "string"
      }
    },
    "examples": {
      "typescript": [
        "import { sanitizeText, sanitizeObject } from './contentSanitizer';",
        "sanitizeText('路人商品'); // 返回 '随机角色'",
        "sanitizeObject(girlData, ['身体特征.罩杯', '性经验.处女']); // 返回去敏感化后的对象"
      ],
      "vueTemplate": [
        "<span>{{ getSanitizedUiText('下单') }}</span>  <!-- 显示 '预订' -->",
        "<span>{{ getSanitizedFieldLabel('处女') }}</span>  <!-- 显示 '初次经历' -->"
      ]
    },
    "implementationNotes": [
      "1. 所有界面显示文本应通过映射函数处理后再展示",
      "2. 字段标签（表格头、详情面板标题等）应使用 getSanitizedFieldLabel()",
      "3. 分类名称应使用 getSanitizedCategory()",
      "4. 导出文件名应使用 sanitizeExportFileName()",
      "5. 保留原始数据不变，仅在显示层进行映射转换"
    ]
  },
