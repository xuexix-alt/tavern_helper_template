        },
        "type": "object",
        "properties": {
          "姓名": {
            "type": "string"
          },
          "关系": {
            "description": "以性关系倾向为主要，反映角色当前对{{user}}的态度",
            "$ref": "#/$defs/__schema4"
          },
          "关系倾向": {
            "description": "角色关系的倾向影响Imp数值的变化幅度",
            "$ref": "#/$defs/__schema4"
          },
          "秩序刻印": {
            "description": "Imp数值(0-100)，衡量关系深度。0无, 1-19拒绝, 20-39交易, 40-59顺从, 60-89忠诚, 90-100性奴",
            "default": 20,
            "type": "number"
          },
          "秩序刻印更新原因": {
            "description": "符合当前角色核心诉求的行动获得更大的Imp值变动，格式示例：+3, 高级设施体验 / -5, 违反等级约束强行提出性要求",
            "type": "string"
          },
          "健康": {
            "description": "范围0-100。记录健康数值。获得食物/温暖增加；受伤/饥饿/寒冷减少。",
            "default": 100,
            "type": "number"
          },
          "健康更新原因": {
            "description": "记录健康值变化的原因和数值，格式：+/-X, 原因描述",
            "type": "string"
          },
          "健康状况": {
            "description": ">=80:健康; 60-79:亚健康; 30-59:生病/受伤; <30:重病/濒死",
            "$ref": "#/$defs/__schema2"
          },
          "衣着": {
            "description": "描述当前的衣着状态包括上衣裤子丝袜内衣内裤",
            "type": "string"
          },
          "舌唇": {
            "description": "口腔、嘴唇的状态",
            "type": "string"
          },
          "胸乳": {
            "description": "胸部的状态或乳房乳头乳晕等在色情挑逗下的反应",
            "type": "string"
          },
          "私穴": {
            "description": "私处的详细状态或反应",
            "type": "string"
          },
          "神态样貌": {
            "description": "面部表情和神态",
            "type": "string"
          },
          "动作姿势": {
            "description": "身体姿态和动作",
            "type": "string"
          },
          "内心想法": {
            "description": "符合角色身份和剧情描述的第一人称内心独白",
            "type": "string"
          },
          "所在房间": {
            "description": "角色所在房间（用于自动纠偏房间数组）。格式：玄关/临时客房A | 核心区/主卧室 | 楼层20/2001；留空表示未知/外出",
            "type": "string"
          },
          "登场状态": {
            "description": "剧情未提及时离场，剧情提及登场，凡在庇护所内一律默认登场\"",
            "$ref": "#/$defs/__schema3"
          }
        }
      }
    },
