{
  "version": 1,
  "preset_id": "default-apocalypse-opening",
  "world_intro": "极寒末日已持续数日，秩序正在瓦解，公寓内每一户都在资源、信任与尊严之间挣扎。",
  "first_line": "伊甸的冷静播报声响起，你必须决定第一步要如何介入这个正在滑向崩塌的世界。",
  "meta_template": {
    "time_label": "时间",
    "location_label": "地点",
    "character_label": "主角"
  },
  "default_meta": {
    "time": "9527年12月14日·14:00",
    "location": "星穹国际公寓2001室",
    "character": "{{user}}"
  },
  "form_schema": [
    {
      "key": "pre_disaster_identity",
      "label": "职业/身份",
      "kind": "text",
      "required": true,
      "placeholder": "例如：护士 / 销售总监 / 保安队长 / 物业经理"
    },
    {
      "key": "shelter_ability_summary",
      "label": "庇护所能力变量",
      "kind": "textarea",
      "required": true,
      "placeholder": "例如：绝对安全屏障、内部安防、基础资源供应、环境循环、侦察网络"
    },
    {
      "key": "early_story_tone",
      "label": "剧情基调",
      "kind": "textarea",
      "required": true,
      "placeholder": "例如：种马、种田、生活、战斗；也可以详细描述你希望前期剧情的重点"
    },
    {
      "key": "opening_style",
      "label": "文风",
      "kind": "select",
      "required": true,
      "options": ["冷峻压迫", "轻小说叙事", "悬疑观察", "高信息密度"],
      "default_value": "轻小说叙事"
    },
    {
      "key": "nearby_factions",
      "label": "社会组织",
      "kind": "textarea",
      "required": false,
      "placeholder": "尽量从现成设定源自动带入，必要时再补充"
    },
    {
      "key": "nearby_survivor_types",
      "label": "其他幸存者类别",
      "kind": "textarea",
      "required": false,
      "placeholder": "尽量从现成设定源自动带入，必要时再补充"
    },
    {
      "key": "supplemental_setting",
      "label": "补充设定",
      "kind": "textarea",
      "placeholder": "例如：想加入的特殊规则、人物关系、隐藏前情、偏好的开局事件"
    },
    {
      "key": "word_count",
      "label": "字数",
      "kind": "text",
      "required": true,
      "default_value": "1500",
      "placeholder": "默认 1500"
    }
  ],
  "prompt_rules": {
    "should_echo_setup": true,
    "output_tags": ["content", "option"]
  }
}
